<Add before="$compiler $options $includes -D__LD__ -E -P cpu\br29\tools\isd_config_rule.c -o cpu\br29\tools\isd_config.ini" />
<Mode before="always" />
<Add after="cpu\br29\tools\download.bat sdk" />
<Mode after="always" />
</ExtraCommands>
</Target>
